# Public browser-safe Supabase project settings.
# Security is enforced with Supabase Auth and Row Level Security policies.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public VAPID key used only to create browser push subscriptions.
VITE_VAPID_PUBLIC_KEY=YOUR_URL_SAFE_VAPID_PUBLIC_KEY

# Browser-restricted Google Maps key and Map ID for the optional filtered Places map.
# Restrict the key by HTTP referrer and to the required Google Maps Platform APIs.
VITE_GOOGLE_MAPS_API_KEY=YOUR_BROWSER_RESTRICTED_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_MAPS_MAP_ID=YOUR_GOOGLE_MAPS_MAP_ID
